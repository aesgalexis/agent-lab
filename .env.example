# Versiones fijadas para que el laboratorio sea reproducible.
AGENT_CANVAS_IMAGE=ghcr.io/openhands/agent-canvas:1.16.0
OLLAMA_IMAGE=ollama/ollama:0.33.1

# Modelo inicial. Cambiarlo aquí basta para las tareas de arranque y prueba.
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CONTEXT_LENGTH=32768

# bootstrap.ps1 sustituye este valor por una ruta absoluta de Windows.
OLLAMA_DATA_PATH="C:/Users/CHANGE_ME/.ollama"

# bootstrap.ps1 genera valores locales aleatorios. Nunca se versiona .env.
LOCAL_BACKEND_API_KEY=CHANGE_ME
OH_SECRET_KEY=CHANGE_ME
